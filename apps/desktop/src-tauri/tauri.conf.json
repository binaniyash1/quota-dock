{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Dock",
  "version": "0.1.0",
  "identifier": "com.quotadock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quota Dock",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Track AI usage across Cursor, Claude, ChatGPT, and Grok",
    "longDescription": "A floating widget that shows your remaining AI quota across all major providers. Always on top, draggable anywhere on screen.",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
